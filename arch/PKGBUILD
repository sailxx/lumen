pkgname=gnome-shell-extension-lumen
pkgver=3
pkgrel=1
pkgdesc='Per-display brightness controls for GNOME Shell'
arch=('any')
url='https://github.com/sailxx/lumen'
license=('MIT')
depends=('gnome-shell>=45' 'ddcutil>=1.4' 'i2c-tools' 'glib2')
makedepends=('git')
source=("lumen::git+https://github.com/sailxx/lumen.git#tag=v${pkgver}")
sha256sums=('SKIP')
install=lumen.install

package() {
  local root="$srcdir/lumen"
  local dest="$pkgdir/usr/share/gnome-shell/extensions/lumen@vlad"
  install -d "$dest/schemas"
  while IFS= read -r entry; do
    [[ -z "$entry" || "$entry" == \#* ]] && continue
    install -D -m644 "$root/extension/$entry" "$dest/$entry"
  done < "$root/extension/extension-files.txt"
  install -Dm644 "$root/extension/schemas/org.gnome.shell.extensions.monitor-brightness.gschema.xml" \
    "$pkgdir/usr/share/glib-2.0/schemas/org.gnome.shell.extensions.monitor-brightness.gschema.xml"
  install -Dm644 "$root/rpm/60-monitor-brightness-i2c.rules" \
    "$pkgdir/usr/lib/udev/rules.d/60-monitor-brightness-i2c.rules"
  install -Dm644 "$root/rpm/i2c-dev.conf" \
    "$pkgdir/usr/lib/modules-load.d/lumen-i2c-dev.conf"
}
